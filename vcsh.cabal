cabal-version:       2.4
name:                vcsh
version:             1.20141026
synopsis:            Version Control System for $HOME
description:
  Maintain several Git repositories in one directory, usually @$HOME@.
  Each repository is a fake-bare Git repository whose work tree is the
  base directory. This is a Haskell port of the @vcsh@ shell script.
homepage:            https://github.com/composewell/vcsh
license:             GPL-2.0-or-later
license-file:        LICENSE
author:              Richard Hartmann, Composewell Technologies
maintainer:          harendra@composewell.com
category:            Development
build-type:          Simple

extra-doc-files:
    README.md
  , changelog

flag limit-build-mem
  description: Limits memory when building
  manual: True
  default: False

common compile-options
    default-language: Haskell2010
    ghc-options:      -Wall
                      -Wcompat
                      -Widentities
                      -Wincomplete-record-updates
                      -Wincomplete-uni-patterns
                      -Wredundant-constraints
    if flag(limit-build-mem)
      ghc-options:  +RTS -M512M -RTS

common default-extensions
    default-extensions:
        LambdaCase
        ScopedTypeVariables

library
  import: compile-options, default-extensions
  hs-source-dirs: src
  build-depends:
      base               >= 4.8   && < 5
    , containers         >= 0.5   && < 0.8
    , streamly-core      >= 0.3.2 && < 0.4
    , streamly-coreutils >= 0.1   && < 0.2
    , streamly-process   >= 0.4   && < 0.5
  exposed-modules:
      Vcsh.Cli
    , Vcsh.Command.Files
    , Vcsh.Command.Repo
    , Vcsh.Command.Run
    , Vcsh.Config
    , Vcsh.Context
    , Vcsh.Error
    , Vcsh.FileSystem
    , Vcsh.Git
    , Vcsh.Hook
    , Vcsh.Log
    , Vcsh.Main
    , Vcsh.Process

executable vcsh
  import: compile-options
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
      base
    , vcsh
  ghc-options: -rtsopts "-with-rtsopts=-M512M"

test-suite compare-with-shell
  import: compile-options
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
      base
    , vcsh
  build-tool-depends: vcsh:vcsh
  ghc-options: -rtsopts "-with-rtsopts=-M512M"
